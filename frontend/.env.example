# Local dev: leave unset — api.ts falls back to http://127.0.0.1:8000/api/v1
# (the Vite dev server on :5173 and the FastAPI backend on :8000 are separate
# processes locally, so this needs to be an absolute URL).
#
# Deployed (single Render service): render.yaml already sets this to the
# relative path /api/v1 at build time — frontend and backend are served from
# the same origin there, so no absolute host is needed. You shouldn't need
# to touch this file unless you split the deploy back into two services.
VITE_API_BASE_URL=/api/v1
